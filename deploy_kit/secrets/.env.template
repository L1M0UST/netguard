# =============================================================================
#  NetGuard 部署环境配置模板
# =============================================================================
#  使用方法：
#    1. 把本文件复制为同目录下的  .env      （文件名就叫 .env，没有别的前缀）
#    2. 按需填入下面的 API Key
#    3. 运行 deploy\2_start_all.ps1
#
#  启动脚本会自动把 secrets\.env 载入为 taishi_platform\.env。
#  发行包内**不含任何真实密钥**；不填也能跑（纯本地模式，见下）。
# =============================================================================

# =============================================================================
#  一、纯本地模式（默认，无需任何 Key）—— 强烈建议比赛现场用这套
# =============================================================================
# 本地微调垂域模型 cqsec（Qwen3-4B QLoRA v3.2，由包内 llama.cpp 拉起，端口 8008）
# 五大能力：单条告警研判 / 事件研判报告 / 攻击者画像 / 威胁情报问答 / 运营总结
CQSEC_BASE_URL=http://127.0.0.1:8008
CQSEC_MODEL=cqsec
CQSEC_TIMEOUT_SECONDS=120
# 任务完成后是否调用 cqsec 生成中文运营总结（1=开，0=关）
CQSEC_OPS_SUMMARY=1

# 云端大模型总开关：0 = 全部走本地模型与规则（不产生任何联网请求、不消耗额度）
#                    1 = 启用下面的云端增强链路
DEEPSEEK_ENABLED=0

# =============================================================================
#  二、云端大模型增强（可选）—— 需要外网与额度
# =============================================================================
# 说明：本平台在 DEEPSEEK_ENABLED=0 时功能完整（本地模型 + 规则引擎），
#       以下 Key 仅用于提升云端研判质量。比赛演示若不联网，请保持 DEEPSEEK_ENABLED=0。
#
# DeepSeek 官方（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# 云端回退链（可选，按 OpenCode → Command Code → DeepSeek 顺序尝试）
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=glm-5.3-flash
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=z-ai/glm-5.3-flash

# =============================================================================
#  三、M3 前端交互层（BFF）配置
# =============================================================================
NETGUARD_WORKSPACE=./workspace
NETGUARD_DATA_DIR=./m3/data
NETGUARD_LLM_ENABLED=1
# 协议：cqsec = 单条 user 消息 + 纯文本回答（本地垂域模型约束，默认）
#       json  = 结构化 JSON 输出（走云端模型时才改）
NETGUARD_LLM_PROTOCOL=cqsec
NETGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
NETGUARD_LLM_MODEL=deepseek-flash
NETGUARD_LLM_API_KEY=
NETGUARD_LLM_TIMEOUT_SECONDS=120
NETGUARD_RAW_TTL_HOURS=72
NETGUARD_ACTOR=local-user

# =============================================================================
#  四、威胁情报在线源（可选，留空自动跳过，不影响本地功能）
# =============================================================================
# AlienVault OTX 免费注册：https://otx.alienvault.com/api
OTX_KEY=
# AbuseIPDB 免费注册：https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=
# 中国大陆访问 ip-api / abuse.ch 等在线源可能需代理，例：http://127.0.0.1:7890
# 留空表示直连；比赛现场不联网时保持留空即可。
NETGUARD_INTEL_PROXY=
