{
  "_comment": "M1 降噪管线运行配置模板。发行包不含任何真实密钥，api_key 一律留空。",
  "_comment_mode": "analysis_mode=local + cascade.mode=local_only 表示 L3 语义研判只走本地 cqsec 模型（8008），不发起任何云端请求。",

  "whitelist_ips": [],
  "whitelist_networks": [],
  "trusted_networks": [],
  "ioc_ips": [],
  "ioc_domains": [],
  "ioc_urls": [],

  "local_ioc": { "enabled": true },

  "session_window_seconds": 300,
  "max_session_duration_seconds": 3600,
  "scan_window_seconds": 60,
  "scan_min_sensitive_paths": 2,
  "source_activity_window_seconds": 300,
  "activity_window_seconds": 1800,
  "dedup_window_seconds": 60,
  "attack_campaign_window_seconds": 3600,
  "scan_min_unique_paths": 5,
  "suspicious_min_score": 45,

  "asset_ids": {},
  "asset_risk": {},
  "shared_egress_ips": [],

  "schema_profile_sample_size": 200,

  "output": {
    "format": "parquet",
    "require_parquet": true,
    "batch_size": 1000,
    "batch_bytes": 8388608
  },

  "threatbook": { "enabled": false },

  "enable_l3_semantic_judge": true,
  "l3_max_ratio": 0.01,

  "llm": {
    "enabled": false,
    "base_url": "",
    "model": "cqsec",
    "api_key": "",
    "timeout_seconds": 120,
    "max_consecutive_failures": 5,
    "max_concurrency": 8,
    "local_max_concurrency": 4,
    "cloud_enabled": false,
    "cascade": {
      "enabled": true,
      "model": "cqsec",
      "mode": "local_only",
      "escalate_below": 0.5
    },
    "providers": [
      { "name": "opencode_go",  "api_key": "", "base_url": "https://opencode.ai/zen/go/v1",            "model": "glm-5.3-flash",      "requires_session": true,  "user_agent": "NetGuard-Security-Research/1.0" },
      { "name": "commandcode",  "api_key": "", "base_url": "https://api.commandcode.ai/provider/v1",    "model": "z-ai/glm-5.3-flash", "requires_session": false, "user_agent": "NetGuard-Security-Research/1.0" },
      { "name": "deepseek",     "api_key": "", "base_url": "https://api.deepseek.com/v1",              "model": "deepseek-flash",     "requires_session": false, "user_agent": "NetGuard-Security-Research/1.0" }
    ],
    "analysis_mode": "local"
  }
}
