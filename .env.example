# =============================================================================
# taishi_platform 统一环境配置模板（复制为 .env 并填入真实值）
# =============================================================================

# ---- DeepSeek 云端大模型（M1 语义研判 + M2 攻击链分析用）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ---- 本地微调垂域模型 cqsec（Qwen3-4B QLoRA v3.2，五大能力）----
CQSEC_BASE_URL=http://127.0.0.1:8008
CQSEC_MODEL=cqsec
CQSEC_TIMEOUT_SECONDS=120
CQSEC_OPS_SUMMARY=1

# ---- M3 BFF (taishi_web server) ----
NETGUARD_WORKSPACE=./workspace
NETGUARD_DATA_DIR=./m3/data
NETGUARD_LLM_ENABLED=1
NETGUARD_LLM_PROTOCOL=cqsec
NETGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
NETGUARD_LLM_MODEL=deepseek-flash
NETGUARD_LLM_API_KEY=
NETGUARD_LLM_TIMEOUT_SECONDS=120
NETGUARD_RAW_TTL_HOURS=72
NETGUARD_ACTOR=local-user

# ---- 云端模型回退链（OpenCode Go → Command Code → DeepSeek）----
# 仅发送已脱敏、确有必要的摘要；三者均使用 OpenAI-compatible 请求格式。
OPENCODE_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=glm-5.3-flash
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=z-ai/glm-5.3-flash

# ---- 在线信誉与本地 IOC 快照 ----
OTX_KEY=
ABUSEIPDB_KEY=
NETGUARD_INTEL_PROXY=http://127.0.0.1:7890
