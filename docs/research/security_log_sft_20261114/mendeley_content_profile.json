  {
    "name": "dataset_description.txt",
    "url": "https://data.mendeley.com/public-files/datasets/zhzd5j9ffy/files/fd8b547b-0c69-4e60-85b4-2c0c06e6f671/file_downloaded",
    "publisher_sha256": "c649c1c8efa9abefe33483a27e352d7bd583745002fe955d5907f6b599ada7e2",
    "size": 5015,
    "bytes_read": 5015,
    "sha256": "c649c1c8efa9abefe33483a27e352d7bd583745002fe955d5907f6b599ada7e2",
    "status": "content_verified",
    "hash_matches_publisher": true,
    "description": "All datasets consist of the following features separated by comma in the following order:\r\n\r\nmethod                           # HTTP request method (GET, POST)\r\nurl                              # full URL string including path and query parameters\r\npayload                          # HTTP request body (empty for GET requests)\r\n\r\n# General meta-features\r\nreq_is_post                      # indicator of POST method (1) vs. GET method (0)\r\nurl_len                          # total length of the URL in characters\r\nbody_len                         # total length of the request body in characters\r\nurl_param_count                  # number of query parameters in the URL\r\nurl_max_param_len                # length of the longest parameter in the URL\r\nurl_avg_param_len                # average length of parameters in the URL\r\nbody_param_count                 # number of parameters in the request body\r\nbody_max_param_len               # length of the longest parameter in the body\r\nbody_avg_param_len               # average length of parameters in the body\r\nurl_path_depth                   # path depth (number of forward slashes / in the path)\r\nurl_domain_count                 # number of dots in the domain\r\nurl_encoding_count               # number of occurrences of the % sign in the URL\r\nbody_encoding_count              # number of occurrences of the % sign in the body\r\nurl_double_encoded               # indicator of double encoding (%25)\r\n\r\n# XSS features\r\nurl_has_script_tag               # presence of <script in the URL path or parameters\r\nbody_has_script_tag              # presence of <script in the request body\r\nurl_has_javascript_proto         # presence of javascript: pseudo-protocol in the URL\r\nbody_has_javascript_proto        # presence of javascript: pseudo-protocol in the body\r\nurl_has_special_chars            # presence of characters < > \" ' ` in the URL\r\nbody_has_special_chars           # presence of characters < > \" ' ` in the body\r\nurl_has_cookie_access            # presence of document.cookie in the URL\r\nbody_has_cookie_access           # presence of document.cookie in the body\r\nurl_has_event_handlers           # JS event handlers (onload=, onerror=...) in the URL\r\nbody_has_event_handlers          # JS event handlers in the body\r\nurl_has_html_tags                # HTML tags (<iframe>, <img>...) in the URL\r\nbody_has_html_tags               # HTML tags in the body\r\nurl_xss_score                    # cumulative XSS score for the URL (sum of indicators)\r\nbody_xss_score                   # cumulative XSS score for the request body\r\n\r\n# SQLi features\r\nurl_has_sql_keywords             # SQL keywords (select, union, where...) in the URL\r\nbody_has_sql_keywords            # SQL keywords in the request body\r\nurl_has_sql_comments             # SQL comments (--, /*, #) in the URL\r\nbody_has_sql_comments            # SQL comments in the request body\r\nurl_has_quote_injection          # quote injection (', \") in the URL\r\nbody_has_quote_injection         # quote injection in the request body\r\nurl_has_sql_functions            # SQL functions (sleep(), concat(), version()...) in the URL\r\nbody_has_sql_functions           # SQL functions in the request body\r\n\r\n# CMDi features\r\nurl_has_shell_operators          # shell operators (|, ||, &&, $()) in the URL\r\nbody_has_shell_operators         # shell operators in the request body\r\nurl_has_shell_commands           # system commands (whoami, cat, dir, ping...) in the URL\r\nbody_has_shell_commands          # system commands in the request body\r\nurl_has_exec_wrappers            # shell wrapper functions (system(), exec()...) in the URL\r\nbody_has_exec_wrappers           # shell wrapper functions in the body\r\n\r\n# LFI / Path Traversal features\r\nurl_directory_traversal_count    # number of traversal patterns (../, ..\\) in the URL\r\nbody_directory_traversal_count   # number of traversal patterns in the body\r\nurl_has_sensitive_files          # sensitive system files (/etc/passwd, win.ini...) in the URL\r\nbody_has_sensitive_files         # sensitive system files in the request body\r\nurl_has_null_byte                # presence of null byte (%00, \\x00) in the URL\r\nbody_has_null_byte               # presence of null byte in the body\r\n\r\n# SSRF features\r\nurl_has_url_scheme               # presence of protocol schemes (http://, file://...) in the URL\r\nbody_has_url_scheme              # presence of protocol schemes in the body\r\nurl_has_internal_ip              # internal and cloud IPs (192.168.x.x, 169.254.x.x) in the URL\r\nbody_has_internal_ip             # internal and cloud IP addresses in the request body\r\nurl_has_localhost                # localhost patterns (127.0.0.1, localhost, ::1...) in the URL\r\nbody_has_localhost               # localhost patterns in the body\r\nurl_has_port_in_param            # port detection within a URL parameter\r\nbody_has_port_in_param           # port detection within a body parameter\r\n\r\nlabel                            # class: 0 (Normal), 1 (XSS), 2 (SQLi), 3 (CMDi), 4 (LFI), 5 (SSRF)"
  },
